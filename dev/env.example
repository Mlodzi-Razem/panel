# dev/env.example — environment for the panel-api container pointed at the dev DB.
#
# LOCAL DEVELOPMENT ONLY. Every value here is a dummy; this file must never hold
# real secrets. The Entra tenant/client IDs are included because they are public
# (they already appear in the web app's client-side configuration).
#
# Docker's --env-file does NOT expand "$(cat ...)", so use plain values here and
# pass the certificate/key contents with -e flags from your own terminal (pattern
# commented below). Only ever paste real key material in a shell you control —
# never into files.

JDBC_URL=jdbc:postgresql://host.docker.internal:5433/panel
JDBC_USER=panel
JDBC_PASSWORD=panel

# At least 32 bytes; this is a throwaway value for local development.
PANEL_API_AUTH_SECRET=devdummy-secret-0123456789-abcdefghijklmnop

# Entra app registration "Panel MR" (public identifiers).
PANEL_ENTRA_TENANT_ID=9e97a4dc-d20d-453b-a3ae-eadfc4c7844b
PANEL_ENTRA_CLIENT_ID=6b106e9e-8d52-48a3-b09e-52985110f6c6

# Real certificate material is NEVER written to files. When you need Entra
# access locally, pass both halves from your own terminal, e.g.:
#   -e PANEL_ENTRA_CLIENT_CERTIFICATE="$(cat ~/panel-certs/panel.crt)"
#   -e PANEL_ENTRA_CLIENT_CERTIFICATE_KEY="$(cat ~/panel-certs/panel.key)"
# Without them Entra stays unconfigured and the api boots fine (empty lookups).
# PANEL_ENTRA_CLIENT_CERTIFICATE=
# PANEL_ENTRA_CLIENT_CERTIFICATE_KEY=
