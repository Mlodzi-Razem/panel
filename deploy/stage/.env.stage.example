# .env.stage.example — template of the STAGE environment file.
#
# The real /opt/panel-stage/.env.stage on the VPS is created from this file
# (RUNBOOK §2) and NEVER leaves that machine. Every value below is either a
# safe public default ("działa-z-placeholderem") or an empty slot marked
# "WARTOŚĆ WKŁADA WŁAŚCICIEL" — the owner pastes real secrets on the VPS
# themselves (commands in RUNBOOK §2). No real secret is ever committed here,
# and no secret ever travels through chat or scripts.
#
# This file has two jobs on the VPS:
#  1. it is the `--env-file` for docker-compose ${...} substitution,
#  2. it is the services' env_file (container environment).
# Compare deploy/stage/RUNBOOK.md for the full lifecycle.

# ===========================================================================
# 1. TOŻSAMOŚĆ ŚRODOWISKA (Caddy/TLS)
# ===========================================================================
# Publiczny host stage'u — rekord A istnieje i wskazuje na VPS.
STAGE_HOST=dev.panel.mlodzirazem.org

# E-mail na powiadomienia/utratę konta ACME (publiczna wartość, np. alarm pocztowy IT).
# WARTOŚĆ WKŁADA WŁAŚCICIEL.
ACME_EMAIL=it@mlodzirazem.org

# Domyślnie produkcyjny Let's Encrypt. Do testów wystawiania certyfikatów
# bez limitów zmień na: https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# ===========================================================================
# 2. POSTGRES (tworzy bazę; migracje wykonuje panel-api przez Flyway)
# ===========================================================================
POSTGRES_DB=panel
POSTGRES_USER=panel

# WARTOŚĆ WKŁADA WŁAŚCICIEL (RUNBOOK §2: `openssl rand -base64 24`).
# Placeholder niżej pozwala uruchomić stack testowy, ale NIE zostawiaj go
# na publicznym stage.
POSTGRES_PASSWORD=stage-db-placeholder-change-me

# JDBC_URL/JDBC_USER wypełnia docker-compose.stage.yaml (adres w sieci
# wewnętrznej: postgres:5432) — nie ustawiaj ich tutaj.

# ===========================================================================
# 3. PANEL-API
# ===========================================================================
# Wspólny sekret tokenów serwisowych (≥32 bajty), ten sam w panel-api i
# panel-web. WARTOŚĆ WKŁADA WŁAŚCICIEL (RUNBOOK §2: `openssl rand -base64 48`).
# Poniższy placeholder spełnia warunek długości, żeby smoke-test działał.
PANEL_API_AUTH_SECRET=stage-placeholder-secret-0123456789-abcdefghijklmnop

# Opcjonalny plik konfiguracyjny montowany do panel-api
# (compose mountuje katalog ./panel-config jako /panel-config).
# Służy głównie do certyfikatów Entra (SSO, RUNBOOK §8). Plik może nie istnieć
# — panel-api startuje bez niego.
PANEL_CONFIG_FILE_PATH=/panel-config/panel-config.yaml

# --- SSO/Entra: na start WYŁĄCZONE — wszystkie wartości puste. ---
# (RUNBOOK §8: "SSO na stage". Tenant ID i client ID są publiczne, ale
# dopóki nie są wpisane, lookups Entra zwracają puste i nikt się nie loguje.)
PANEL_ENTRA_TENANT_ID=
PANEL_ENTRA_CLIENT_ID=
PANEL_ENTRA_CLIENT_SECRET=
# Certyfikaty (PEM) nie mieszczą się wygodnie w pliku env (wielolinijkowe);
# preferowany kanał to panel-config.yaml — patrz RUNBOOK §8. Pozostaw puste.
PANEL_ENTRA_CLIENT_CERTIFICATE=
PANEL_ENTRA_CLIENT_CERTIFICATE_KEY=

# ===========================================================================
# 4. PANEL-WEB
# ===========================================================================
PANEL_APP_NAME=Panel MR STAGE

# panel-web woła panel-api server-side po adresie z sieci wewnętrznej.
# (Ustawiane sztywno w docker-compose.stage.yaml, tu tylko dokumentacja.)
PANEL_API_URL=http://panel-api:8080

# WARTOŚĆ WKŁADA WŁAŚCICIEL (RUNBOOK §2: `openssl rand -base64 24`).
# Token do scrape'owania /api/metrics; placeholder wystarczy na smoke-test.
PANEL_METRICS_AUTH_TOKEN=stage-metrics-placeholder-change-me

# Google OAuth — panel-web wymaga tych zmiennych, żeby w ogóle wystartować
# (config/env.ts). Placeholdery = przycisk "Zaloguj przez Google" NIE zadziała
# na stage (celowo na start). Jeśli właściciel zechce sprawdzić ekran logowania
# bez produkcyjnych poświadczeń, może podstawiać wartości z produkcji, ale
# trzeba wtedy dodać redirect URI stage'u w Google Cloud Console (koniec
# tematu w RUNBOOK §8).
PANEL_GOOGLE_CLIENT_ID=stage-signin-disabled.example
PANEL_GOOGLE_CLIENT_SECRET=stage-signin-disabled.example
PANEL_GOOGLE_WORKSPACE_DOMAIN=mlodzirazem.org

# NextAuth: URL aplikacji + sekret sesji.
NEXTAUTH_URL=https://dev.panel.mlodzirazem.org
# (żeżeli zmienisz STAGE_HOST powyżej, zaktualizuj też NEXTAUTH_URL!)
# WARTOŚĆ WKŁADA WŁAŚCICIEL (RUNBOOK §2: `openssl rand -base64 32`).
NEXTAUTH_SECRET=stage-nextauth-placeholder-change-me

# --- SSO/Entra w panel-web: na start WYŁĄCZONE. ---
# Panel-web czyta TE SAME zmienne PANEL_ENTRA_TENANT_ID / PANEL_ENTRA_CLIENT_ID
# co panel-api (sekcja 3) — jeden plik env obsługuje oba serwisy. Wpisz je
# bezpośrednio w sekcji 3; to tu tylko przypomnienie, żeby niczego nie dublować.
# Uwaga: PANEL_ENTRA_CLIENT_SECRET z sekcji 3 jest dodatkowo używany przez
# panel-web do logowania w przeglądarce (jeśli tenant sekrety blokuje, pomiń
# sekret i podnieś temat w RUNBOOK §8).

# ===========================================================================
# 5. OBECNY RELEASE (aktualizuje ci/release-local.sh przez docker tag)
# ===========================================================================
# Compose używa "stage" jako ruchomego wskaźnika na wydany obraz.
# Nie edytuj — rollbackiem steruje scripts/rollback.sh na VPS.
PANEL_API_IMAGE=panel-api:stage
PANEL_WEB_IMAGE=panel-web:stage
