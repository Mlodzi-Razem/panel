{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.1.1",
  "id": "{{APP_ID}}",
  "localizationInfo": {
    "defaultLanguageTag": "pl-pl"
  },
  "developer": {
    "name": "Stowarzyszenie Młodzi Razem",
    "websiteUrl": "https://mlodzirazem.org",
    "privacyUrl": "https://{{HOST}}/teams/about",
    "termsOfUseUrl": "https://{{HOST}}/teams/about"
  },
  "name": {
    "short": "Panel MR{{NAME_SUFFIX}}",
    "full": "Panel MR – Młodzi Razem{{NAME_SUFFIX}}"
  },
  "description": {
    "short": "Twoje członkostwo, okręg i głosowania w Młodych Razem.",
    "full": "Panel MR to system członkowski Stowarzyszenia Młodzi Razem. Bezpośrednio w Microsoft Teams sprawdzisz swoje członkostwo, zobaczysz informacje o swoim okręgu, weźmiesz udział w głosowaniach i znajdziesz najważniejsze informacje o Panelu. Logujesz się automatycznie kontem Microsoft 365 stowarzyszenia."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#720546",
  "staticTabs": [
    {
      "entityId": "home",
      "name": "Strona główna",
      "contentUrl": "https://{{HOST}}/teams/home",
      "websiteUrl": "https://{{HOST}}/",
      "scopes": ["personal"]
    },
    {
      "entityId": "membership",
      "name": "Moje członkostwo",
      "contentUrl": "https://{{HOST}}/teams/membership",
      "websiteUrl": "https://{{HOST}}/",
      "scopes": ["personal"]
    },
    {
      "entityId": "district",
      "name": "Okręg",
      "contentUrl": "https://{{HOST}}/teams/district",
      "websiteUrl": "https://{{HOST}}/",
      "scopes": ["personal"]
    },
    {
      "entityId": "votes",
      "name": "Głosowania",
      "contentUrl": "https://{{HOST}}/teams/votes",
      "websiteUrl": "https://{{HOST}}/",
      "scopes": ["personal"]
    },
    {
      "entityId": "info",
      "name": "Informacje",
      "contentUrl": "https://{{HOST}}/teams/about",
      "websiteUrl": "https://{{HOST}}/",
      "scopes": ["personal"]
    }
  ],
  "permissions": ["identity"],
  "validDomains": ["{{HOST}}"],
  "webApplicationInfo": {
    "id": "6b106e9e-8d52-48a3-b09e-52985110f6c6",
    "resource": "api://{{HOST}}/6b106e9e-8d52-48a3-b09e-52985110f6c6"
  },
  "showLoadingIndicator": false
}
